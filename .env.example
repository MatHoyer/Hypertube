TRANSMISSION_HOST=localhost
TRANSMISSION_RCP_PORT=9091
TRANSMISSION_TORRENT_PORT=51413

REDIS_HOST=localhost
REDIS_PORT=6379
EXPOSED_REDIS_PORT=6379 # dev only (docker override)

TMDB_TOKEN=

PROWLARR_URL=http://localhost:9696
# Generate with: openssl rand -hex 16
# Or leave empty — prowlarr-init-config.sh generates one and writes it to the config volume
PROWLARR_API_KEY=
# Prod/docker: read key from prowlarr-init output (default /prowlarr-config/api_key)
# PROWLARR_API_KEY_FILE=/prowlarr-config/api_key
PROWLARR_PORT=9696
# Comma-separated Prowlarr definition names (see GET /api/v1/indexer/schema)
# Aliases: tpb/thepiratebay, tgx/torrentgalaxy, lime/limetorrents, kickass/kat, tp/torrentproject
# Optional extras (often need FlareSolverr or extra setup): 1337x, extratorrent-st
# Note: torrentgalaxyclone may fail if the site blocks your VPN IP
PROWLARR_INDEXERS=yts,thepiratebay,limetorrents,torrentdownloads,torrentproject2
# Optional: limit Hypertube searches to specific Prowlarr indexer IDs (leave empty for all)
PROWLARR_INDEXER_IDS=

SUBTITLE_PROXY_URL=http://localhost:3042
SUBTITLE_PROXY_PORT=3042

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

VPN_IS_ACTIVE=true

OPENVPN_USER=
OPENVPN_PASSWORD=