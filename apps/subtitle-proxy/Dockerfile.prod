FROM node:22 AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /hypertube

COPY pnpm-workspace.yaml ./
COPY package.json pnpm-lock.yaml ./
COPY .env ./
COPY eslint.config.js ./

COPY apps/subtitle-proxy ./apps/subtitle-proxy
COPY packages/libs ./packages/libs
COPY packages/server-core ./packages/server-core

RUN pnpm i --frozen-lockfile
RUN pnpm lint
RUN pnpm --filter server-core prisma:generate
RUN pnpm build:subtitle-proxy

RUN find /hypertube/node_modules -type f \
  \( -name "*.md" -o -name "*.markdown" -o -name "*.map" -o -name "*.ts" -o -name "*.mts" -o -name "*.cts" -o -name "*.d.ts" \) \
  -delete

# Prisma 7 client bundles query-compiler WASM for every DB (postgres/mysql/sqlite/
# sqlserver/cockroach) x fast/small x js/mjs (~70MB). Generator has no compilerBuild
# override so it defaults to bundling both; we only ever run postgresql + small, drop the rest.
RUN find /hypertube/node_modules \
  -path "*/@prisma/client/runtime/query_compiler_*" \
  ! -name "*small_bg.postgresql*" \
  -delete

# @prisma/client declares the `prisma` CLI as an OPTIONAL peer dependency, which
# `pnpm install` still installs. The CLI drags in Studio, the local dev server
# (@prisma/dev + pglite) and migration engines (@prisma/engines) — never used at
# runtime (queries go through @prisma/adapter-pg + the WASM compiler above).
RUN rm -rf \
  /hypertube/node_modules/.pnpm/prisma@* \
  /hypertube/node_modules/.pnpm/@prisma+dev@* \
  /hypertube/node_modules/.pnpm/@prisma+studio-core@* \
  /hypertube/node_modules/.pnpm/@prisma+config@* \
  /hypertube/node_modules/.pnpm/@prisma+engines@* \
  /hypertube/node_modules/.pnpm/@prisma+fetch-engine@* \
  /hypertube/node_modules/.pnpm/@prisma+get-platform@* \
  /hypertube/node_modules/.pnpm/@electric-sql+pglite* \
  /hypertube/node_modules/.pnpm/node_modules/prisma \
  /hypertube/node_modules/.pnpm/node_modules/@prisma \
  && rm -f /hypertube/node_modules/.pnpm/node_modules/.bin/prisma 2>/dev/null || true

FROM node:22-alpine AS runner

RUN apk add --no-cache chromium nss freetype harfbuzz ttf-freefont

WORKDIR /hypertube

COPY --from=builder /hypertube/node_modules ./node_modules
COPY --from=builder /hypertube/apps/subtitle-proxy/node_modules ./apps/subtitle-proxy/node_modules
COPY --from=builder /hypertube/packages/libs/node_modules ./packages/libs/node_modules
COPY --from=builder /hypertube/packages/server-core/node_modules ./packages/server-core/node_modules

COPY --from=builder /hypertube/apps/subtitle-proxy/dist ./apps/subtitle-proxy/dist
COPY --from=builder /hypertube/packages/libs/dist ./packages/libs/dist
COPY --from=builder /hypertube/packages/server-core/dist ./packages/server-core/dist

COPY --from=builder /hypertube/apps/subtitle-proxy/package.json ./apps/subtitle-proxy/package.json
COPY --from=builder /hypertube/packages/libs/package.json ./packages/libs/package.json
COPY --from=builder /hypertube/packages/server-core/package.json ./packages/server-core/package.json

WORKDIR /hypertube/apps/subtitle-proxy

CMD ["node", "./dist/apps/subtitle-proxy/src/main.js"]
