enum DownloadState {
  NOT_DOWNLOADED
  WAITING
  DOWNLOADING
  DOWNLOADED
}

enum Provider {
  YTS
}

model Resolution {
  id String @id @default(uuid())

  resolution    String
  size          String
  downloadState DownloadState @default(NOT_DOWNLOADED)
  provider      Provider?

  Movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([movieId, resolution])
}

model Subtitle {
  id String @id @default(uuid())

  language      String
  rating        Int
  downloadLink  String        @unique
  downloadState DownloadState @default(NOT_DOWNLOADED)

  Movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movie {
  id     String @id @default(uuid())
  tmdbId Int    @unique
  imdbId String @unique

  resolutions Resolution[]
  subtitles   Subtitle[]

  additionalInfoFetched Boolean @default(false)
  demoMovie             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usedAt DateTime @default(now())
}
