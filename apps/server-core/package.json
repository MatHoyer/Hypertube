{
  "name": "@hypertube/server-core",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "prisma": {
    "schema": "./prisma/schema",
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "clear": "rm -rf node_modules dist prisma/schema/migrations src/generated",
    "build": "tsc --build",
    "dev": "tsc -w --preserveWatchOutput",
    "prisma:generate": "pnpm dlx prisma generate",
    "prisma:migrate": "pnpm dlx prisma migrate dev --name init",
    "prisma:migrate:reset": "pnpm dlx prisma migrate reset --force",
    "prisma:seed": "pnpm dlx prisma db seed",
    "prisma:studio": "pnpm dlx prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@hypertube/libs": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "dotenv-cli": "^8.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.7.1"
  }
}
