{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@hypertube/libs": ["../../packages/libs/src"],
      "@hypertube/server-core": ["../../packages/server-core/src"]
    }
  },
  "include": ["src"]
}
