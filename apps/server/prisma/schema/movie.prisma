model Resolution {
  id String @id @default(uuid())

  resolution String
  size       String
  link       String @unique

  Movie   Movie?  @relation(fields: [movieId], references: [id])
  movieId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([movieId, resolution])
}

model Subtitle {
  id String @id @default(uuid())

  language String
  link     String @unique

  Movie   Movie?  @relation(fields: [movieId], references: [id])
  movieId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([movieId, language])
}

model Movie {
  id String @id @default(uuid())

  title       String
  description String?
  imageUrl    String
  link        String  @unique

  resolutions Resolution[]
  subtitles   Subtitle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usedAt DateTime @default(now())
}
