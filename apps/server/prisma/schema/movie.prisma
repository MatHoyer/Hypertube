model Resolution {
  id String @id @default(uuid())

  resolution String
  link       String @unique

  Movie   Movie?  @relation(fields: [movieId], references: [id])
  movieId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([movieId, resolution])
}

model Subtitle {
  id String @id @default(uuid())

  language String
  rating   Int
  link     String @unique

  Movie   Movie?  @relation(fields: [movieId], references: [id])
  movieId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movie {
  id String @id @default(uuid())

  title       String
  year        Int?
  description String?
  imageUrl    String
  link        String  @unique

  resolutions Resolution[]
  subtitles   Subtitle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usedAt DateTime @default(now())
}
