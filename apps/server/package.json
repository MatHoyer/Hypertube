{
  "name": "server",
  "scripts": {
    "clear": "rm -rf node_modules dist",
    "dev": "nodemon --watch src --watch ../../packages/server-core/src --watch ../../packages/libs/src --ext ts --exec 'tsx src/main.ts'",
    "build": "tsc && cp -r src/emails/default-email.html dist/apps/server/src/emails",
    "start": "node dist/apps/server/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@hono/swagger-ui": "^0.5.2",
    "@hypertube/libs": "workspace:*",
    "@hypertube/server-core": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.3.7",
    "hono": "^4.12.18",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.5",
    "resend": "^4.7.0",
    "sharp": "^0.34.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.28.0",
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^7.0.11",
    "nodemon": "^3.1.14",
    "testcontainers": "^10.28.0",
    "tsx": "^4.7.1",
    "vitest": "^3.2.4"
  }
}
