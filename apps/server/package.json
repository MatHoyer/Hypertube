{
  "name": "server",
  "scripts": {
    "clear": "rm -rf node_modules dist",
    "dev": "nodemon --watch src --watch ../../packages/server-core/src --watch ../../packages/libs/src --ext ts --exec 'tsx src/main.ts'",
    "build": "tsc && cp -r src/emails/default-email.html dist/apps/server/src/emails",
    "start": "node dist/apps/server/src/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@hono/swagger-ui": "^0.6.1",
    "@hypertube/libs": "workspace:*",
    "@hypertube/server-core": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.3.7",
    "hono": "^4.8.5",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.8",
    "resend": "^6.12.3",
    "sharp": "^0.34.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.7.1"
  }
}
