{
  "name": "hypertube",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clear": "rm -rf node_modules && pnpm -r clear",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r --parallel build",

    "dev:web": "pnpm --filter lib --filter server --filter client --parallel dev",
    "build:web": "pnpm --filter libs --filter server --filter client build",
    "start:web": "pnpm --filter server start",

    "dev:workers:scrapper": "pnpm --filter scrapper dev",
    "build:workers:scrapper": "pnpm --filter libs --filter scrapper build",
    "start:workers:scrapper": "pnpm --filter scrapper start",

    "dev:workers:downloader": "pnpm --filter downloader dev",
    "build:workers:downloader": "pnpm --filter libs --filter downloader build",
    "start:workers:downloader": "pnpm --filter downloader start",
    
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "better-auth": "^1.3.7",
    "bullmq": "^5.58.5",
    "date-fns": "^4.1.0",
    "i18next": "^25.4.2",
    "zod": "^4.0.5"
  }
}
