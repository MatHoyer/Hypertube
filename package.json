{
  "name": "hypertube",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "//-- Cleaning --": "",
    "clear": "rm -rf node_modules && pnpm -r clear",
    "//-- App --": "",
    "dev:app": "pnpm -r --parallel --filter 'server...' --filter 'client...' dev",
    "build:app": "pnpm -r --filter 'server...' --filter 'client...' build",
    "start:app": "pnpm --filter server start",
    "//-- Downloader --": "",
    "dev:downloader": "pnpm -r --parallel --filter 'downloader...' dev",
    "build:downloader": "pnpm -r --filter 'downloader...' build",
    "start:downloader": "pnpm --filter downloader start",
    "//-- Scheduler --": "",
    "dev:scheduler": "pnpm -r --parallel --filter 'scheduler...' dev",
    "build:scheduler": "pnpm -r --filter 'scheduler...' build",
    "start:scheduler": "pnpm --filter scheduler start",
    "//-- Yts Api Proxy --": "",
    "dev:yts-api-proxy": "pnpm -r --parallel --filter 'yts-api-proxy...' dev",
    "build:yts-api-proxy": "pnpm -r --filter 'yts-api-proxy...' build",
    "start:yts-api-proxy": "pnpm --filter yts-api-proxy start",
    "//-- Build pacakges --": "",
    "build:libs": "pnpm --filter libs build",
    "build:server-core": "pnpm --filter server-core build",
    "build:packages": "pnpm build:libs && pnpm build:server-core",
    "//-- without proxy --": "",
    "dev:without-proxy": "pnpm build:packages && pnpm -r --parallel --filter !yts-api-proxy dev",
    "build:without-proxy": "pnpm build:packages && pnpm -r --parallel --filter !yts-api-proxy build",
    "start:without-proxy": "pnpm -r --parallel --filter !yts-api-proxy start",
    "//-- All --": "",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "build": "pnpm build:packages && pnpm -r --parallel build",
    "start": "pnpm -r --parallel start",
    "//-- Linting --": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.18",
      "valibot": ">=1.2.0",
      "lodash": ">=4.18.0",
      "effect": ">=3.20.0",
      "@hono/node-server": ">=1.19.13",
      "ip-address": ">=10.1.1",
      "zod": "4.4.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "bullmq": "^5.77.2",
    "date-fns": "^4.3.0",
    "i18next": "^25.10.10",
    "ioredis": "^5.10.1",
    "zod": "^4.4.3"
  }
}
